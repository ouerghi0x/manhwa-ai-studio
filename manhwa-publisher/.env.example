# Optional environment variable overrides for manhwa-publisher
# Copy this file to .env if you want to customize paths or behavior.

# Path to YAML configuration file
# MANHWA_PUBLISHER_CONFIG=config.yaml

# Override credentials directory
# MANHWA_PUBLISHER_CREDENTIALS_DIR=credentials

# Override OAuth client secrets filename inside credentials directory
# MANHWA_PUBLISHER_CLIENT_SECRETS=client_secrets.json

# Override OAuth token filename inside credentials directory
# MANHWA_PUBLISHER_TOKEN_FILE=token.json

# Override SQLite database path
# MANHWA_PUBLISHER_DB_PATH=data/publisher.db

# Override log level (DEBUG, INFO, WARNING, ERROR)
# MANHWA_PUBLISHER_LOG_LEVEL=INFO
