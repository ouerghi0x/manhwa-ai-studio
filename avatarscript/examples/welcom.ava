scene "anime_reaction":

    canvas 1080x1920
    background "#202020"
    fps 30
    duration 12s

    avatar "main":

        character "default"

        position center
        scale 2
        hold item:"microphone" hand:right scale:1.3

        idle:
            breathe
            blink every 1s

        at 0s:
            expression neutral
            left_arm 0 duration 0.2s
            right_arm 0 duration 0.2s
            animate shake duration 0.4s


        at 3s:
            expression surprised
            left_arm 55 duration 0.4s
            animate shake duration 0.4s

        at 6s:
            expression happy
            left_arm 0 duration 0.25s
            right_arm -55 duration 0.4s
            animate bounce duration 0.6s

        at 9s:
            expression angry
            move x:30 y:0 duration 0.3s
            aura green size:25 intensity:10 speed:1.2 sparks:0 duration 3s
            shake intensity:4 duration 1.0s

    render "output.mp4"
