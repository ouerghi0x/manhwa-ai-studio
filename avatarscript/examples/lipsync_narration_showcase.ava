# Speech Audio Lip-Sync Showcase
# Demonstrates avatar narrator talking in real-time synchronized to actual voiceover audio from production/

scene "Speech Lip-Sync Narration":
    canvas 1920x1080
    background "#14151e"
    fps 30
    duration 8.0s
    render "lipsync_narration_showcase.mp4"

    avatar "Narrator":
        character "default"
        position center
        scale 1.2
        hold item:"microphone" hand:right scale:1.3

        idle:
            breathe
            blink every 3.5s

        at 0.0s:
            expression neutral
            right_arm deg:-35 duration 0.3s easing ease_out

        # Audio-driven lip-sync: mouth dynamically articulates syllables from production voice track
        at 0.5s:
            talk audio:"production/voices/voice_part1.mp3" duration 7.0s
            nod duration 0.4s intensity:10

        at 3.0s:
            expression happy
            nod duration 0.35s intensity:8

        at 5.5s:
            expression neutral
            right_arm deg:-20 duration 0.4s
