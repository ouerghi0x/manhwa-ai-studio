# AvatarScript Example: Arm Gestures & Multi-Character Battle (1920x1080 @ 30 FPS)
# Demonstrates:
# 1. New characters: "ninja" and "demon"
# 2. Independent left and right arm control (left_arm, right_arm, arm deg:...)
# 3. Dynamic interaction, nods, bounces, and expressions

scene "arm_control_and_characters":

    canvas 1920x1080
    background "#0d1117"
    fps 30
    duration 9s

    avatar "shinobi":
        character "ninja"
        position x:500 y:680
        scale 1.15

        idle:
            breathe
            blink every 3.5s

        at 0s:
            expression neutral
            left_arm 0 duration 0.2s
            right_arm 0 duration 0.2s

        at 1.0s:
            # Ninja raises right arm in salute/jutsu pose
            expression smirk
            right_arm -55 duration 0.35s easing ease_out
            animate nod duration 0.3s intensity 10

        at 2.8s:
            # Ninja raises both arms into battle stance
            left_arm 45 duration 0.35s easing ease_out
            right_arm -80 duration 0.35s easing ease_out
            scale 1.25 duration 0.3s easing elastic_out

        at 5.5s:
            # Ninja leaps forward with arm swing
            expression angry
            animate bounce duration 0.5s intensity 22
            left_arm 70 duration 0.25s easing ease_out
            right_arm -110 duration 0.25s easing ease_out
            move x:80 y:0 duration 0.3s

        at 7.5s:
            # Victory pose: lowers left, raises right in triumph
            expression happy
            left_arm 0 duration 0.4s easing ease_in_out
            right_arm -135 duration 0.4s easing elastic_out

    avatar "oni":
        character "demon"
        position x:1420 y:680
        scale 1.25

        idle:
            breathe
            blink every 4.0s

        at 0s:
            expression angry
            left_arm 0 duration 0.2s
            right_arm 0 duration 0.2s

        at 1.5s:
            # Demon raises left arm menacingly
            expression smirk
            left_arm 60 duration 0.4s easing ease_out
            scale 1.3 duration 0.3s easing ease_out

        at 3.5s:
            # Roaring challenge: both arms raised high!
            expression shocked
            left_arm 110 duration 0.3s easing elastic_out
            right_arm -110 duration 0.3s easing elastic_out
            animate shake duration 0.5s intensity 18

        at 6.0s:
            # Taking a hit! Arms flail back
            expression sad
            animate shake duration 0.6s intensity 25
            left_arm 20 duration 0.3s easing ease_out
            right_arm -20 duration 0.3s easing ease_out
            rotate 8 duration 0.3s easing ease_out

        at 7.8s:
            # Growling recovery
            expression angry
            rotate 0 duration 0.3s easing ease_in_out
            left_arm 45 duration 0.4s easing ease_out
            right_arm -45 duration 0.4s easing ease_out

    render "arm_control_and_characters.mp4"
