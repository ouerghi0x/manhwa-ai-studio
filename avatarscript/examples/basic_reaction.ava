# Basic Reaction Example in AvatarScript v0.1

scene "basic_reaction":

    canvas 1920x1080
    background "#1E293B"
    fps 30
    duration 6s

    avatar "host":

        character "default"

        position center
        scale 1.15

        idle:
            breathe
            blink every 3.5s

        at 0s:
            expression neutral

        at 1.5s:
            expression surprised
            animate bounce duration 0.5s

        at 3.5s:
            expression happy
            move x:80 y:-20 duration 0.6s easing ease_out

    render "basic_reaction.mp4"
