scene "Explosion & Reassembly Showcase":
    canvas 1920x1080
    fps 30
    duration 7.0s
    background "#121118"

    avatar "FlameEmperor":
        character "flame_emperor"
        position center
        scale 1.35

        idle:
            breathe
            blink every 3.5s

        at 0.0s:
            expression smirk

        at 1.0s:
            expression surprised
            shake intensity:12 duration 0.4s

        # Dynamic Explode Animation with Fiery Blast, Shockwave & Floating Embers:
        at 1.5s:
            explode duration 3.5s scatter:0.5s separated:1.6s reassemble:1.4s intensity:1.2 fire:true color:"orange"

        at 5.2s:
            expression smirk
            nod intensity:8 duration 0.6s

        at 5.8s:
            expression happy
            arm target:right deg:65 duration 0.6s
