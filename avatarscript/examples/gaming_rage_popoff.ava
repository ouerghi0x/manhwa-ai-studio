# AvatarScript Example: Gaming Rage & Pop-Off (1080x1920 9:16 Vertical Shorts @ 60 FPS)
# Demonstrates:
# 1. High frame-rate vertical content
# 2. Rapid emotional transitions (neutral -> smirk -> angry -> rage shake -> happy)
# 3. Dynamic scale punch with "elastic_out" easing and "nod" agreement

scene "gaming_rage_popoff":

    canvas 1080x1920
    background "#12131C"
    fps 60
    duration 8s

    avatar "streamer":
        character "default"
        position x:540 y:1380
        scale 1.15
        rotation 0

        idle:
            breathe
            blink every 3.5s

        at 0s:
            expression smirk
            fade 1.0 duration 0.3s easing ease_out

        at 1.2s:
            # Cocky nod before the boss fight
            animate nod duration 0.35s intensity 12
            scale 1.22 duration 0.3s easing elastic_out

        at 2.8s:
            # Sudden fatal blow from boss!
            expression shocked
            animate shake duration 0.5s intensity 22
            rotate -8 duration 0.25s easing ease_out

        at 4.2s:
            # Pure desk-slam rage
            expression angry
            animate shake duration 0.6s intensity 26
            scale 1.32 duration 0.25s easing ease_out
            rotate 0 duration 0.2s easing ease_out

        at 6.0s:
            # Clutch revive & victorious laughter
            expression happy
            animate bounce duration 0.65s intensity 25
            scale 1.15 duration 0.4s easing elastic_out

        at 7.4s:
            # Proud concluding nod
            expression smirk
            animate nod duration 0.35s intensity 10

    render "gaming_rage_popoff.mp4"
