# Pixel Narrator / Manhwa Commentary Streamer Showcase
# Built directly from the user's pixel art illustration.
# Demonstrates 16-bit retro anime streamer avatar, speech lip-sync visemes,
# broadcast condenser microphone, head turns, and expressive reactions.

scene "Pixel Narrator Streamer Showcase":
    canvas 1920x1080
    background "#13101E"
    fps 30
    duration 6.0s
    render "examples/pixel_narrator_streamer_demo.mp4"

    avatar "Streamer":
        character "pixel_narrator"
        position center
        scale 1.35
        hold item:"streamer_mic" hand:right scale:1.1

        idle:
            breathe
            blink every 3.0s

        # 0.0s: Calm, attentive studio narrator greeting
        at 0.0s:
            expression neutral
            head_turn yaw:-10 duration 0.4s

        # 1.0s: Opening hook commentary with happy smile & speech visemes
        at 1.0s:
            expression happy
            head_turn yaw:12 duration 0.35s
            right_arm deg:-25 duration 0.3s
            talk duration 1.2s

        # 2.2s: Plot twist reaction! Shocked gasp with screen bounce & cyan aura
        at 2.2s:
            expression shocked
            head_turn yaw:0 duration 0.2s
            aura cyan size:40 intensity:1.2 speed:1.6 sparks:1 duration 0.3s
            bounce intensity:12 duration 0.5s
            shake intensity:6 duration 0.8s
            left_arm deg:25 duration 0.25s

        # 3.4s: Passionate commentary / angry rant at the villain
        at 3.4s:
            expression angry
            aura purple size:50 intensity:1.8 speed:2.0 sparks:1 duration 0.3s
            shake intensity:14 duration 1.0s
            right_arm deg:-35 duration 0.25s
            talk duration 1.0s

        # 4.6s: Calms down with confident smirk & head tilt
        at 4.6s:
            expression smirk
            aura none duration 0.3s
            scale 1.35 duration 0.4s easing ease_in_out
            right_arm deg:-10 duration 0.3s
            left_arm deg:0 duration 0.3s
            talk duration 0.9s

        # 5.5s: Return smoothly to neutral
        at 5.5s:
            expression neutral
            right_arm deg:0 duration 0.3s
