# AvatarScript Example: Duo Commentary / Debate Scene (16:9 @ 30 FPS)
# Demonstrates:
# 1. Multi-avatar simultaneous interaction in a single scene
# 2. New expression: "smirk"
# 3. New transient animation: "nod"
# 4. New easing curve: "elastic_out"

scene "duo_commentary_debate":

    canvas 1920x1080
    background "#1a1b26"
    fps 30
    duration 10s

    avatar "analyst":
        character "default"
        position x:480 y:680
        scale 1.15
        rotation 0

        idle:
            breathe
            blink every 3.8s

        at 0s:
            expression neutral
            fade 1.0 duration 0.3s easing ease_out

        at 1.5s:
            # Emphatic head nod while explaining a point
            expression smirk
            animate nod duration 0.4s intensity 10
            scale 1.2 duration 0.3s easing ease_out

        at 4.0s:
            # Agreeing with co-host
            expression happy
            animate nod duration 0.5s intensity 12
            scale 1.15 duration 0.4s easing ease_in_out

        at 6.5s:
            # Listening skeptically
            expression neutral
            rotate -4 duration 0.3s easing ease_out

        at 8.5s:
            # Concluding smile
            expression smirk
            rotate 0 duration 0.3s easing ease_in_out

    avatar "reactor":
        character "default"
        position x:1440 y:680
        scale 1.15
        rotation 0

        idle:
            breathe
            blink every 3.2s

        at 0s:
            expression happy
            fade 1.0 duration 0.3s easing ease_out

        at 2.0s:
            # Sudden shock & elastic pop-in bounce
            expression surprised
            animate bounce duration 0.6s intensity 20
            scale 1.3 duration 0.4s easing elastic_out

        at 5.0s:
            # Shocked disbelief
            expression shocked
            animate shake duration 0.45s intensity 18
            rotate 6 duration 0.3s easing ease_out

        at 7.5s:
            # Relieved laughter
            expression happy
            rotate 0 duration 0.3s easing ease_in_out
            scale 1.15 duration 0.5s easing ease_in_out
            animate nod duration 0.4s intensity 8

    render "duo_commentary_debate.mp4"
