scene "Gongja Full-Body Movement & Jump Demo":
    canvas 1920x1080
    background "#141620"
    fps 30
    duration 6.5s
    render "examples/gongja_movement_jump_demo.mp4"

    avatar "Gongja":
        character "gongja"
        position x:480 y:620
        scale 1.25

        idle:
            breathe
            blink every 3.0s

        # 1. Walk calmly onto center stage
        at 0.0s:
            expression neutral
            head_turn yaw:-15 duration 0.4s
            walk to_x:960 duration 1.5s speed:1.1

        # 2. High jump & fist bump
        at 1.7s:
            expression happy
            head_turn yaw:0 duration 0.25s
            jump x:180 height:140 duration 0.8s

        # 3. Draw sword & battle stance with independent leg pose + crimson aura
        at 2.7s:
            expression angry
            hold item:"sword" hand:right scale:1.3
            animate aura on intensity:0.95 color:red
            right_arm -40 duration 0.25s
            left_leg 24 duration 0.25s
            right_leg -24 duration 0.25s

        # 4. Reset stance & sprint back left
        at 3.8s:
            expression shocked
            left_leg 0 duration 0.15s
            right_leg 0 duration 0.15s
            right_arm 0 duration 0.15s
            hold item:"none" hand:right
            animate aura off duration 0.15s
            run to_x:660 duration 1.1s speed:1.2

        # 5. Cool stop, check phone & smirk
        at 5.1s:
            expression smirk
            hold item:"phone" hand:left scale:1.1
            talk duration 1.0s
