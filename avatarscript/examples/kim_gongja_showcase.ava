scene "Kim_Gong_ja_Showcase":
    canvas 1920x1080
    background "#0F1017"
    fps 30
    duration 5.0s
    render "renders/kim_gongja_showcase.mp4"

    avatar "mc":
        character "gongja"
        position center
        scale 1.3
        hold item:"sword" hand:right scale:1.4

        idle:
            breathe
            blink every 3.2s

        at 0.0s:
            expression neutral

        # 1. Look toward panel with 2.5D head turn
        at 0.8s:
            head_turn yaw:-28 pitch:8 duration 0.5s easing ease_out
            look at:left duration 0.25s
            expression smirk

        # 2. Power-up / Envy determination
        at 2.0s:
            expression angry
            aura red size:45 intensity:1.6 speed:1.8 sparks:1 duration 0.3s
            right_arm -55 duration 0.35s easing ease_out
            bounce intensity:12 duration 0.4s

        # 3. Look front & calm down
        at 3.6s:
            expression neutral
            head_turn yaw:0 pitch:0 duration 0.5s easing ease_in_out
            look at:center duration 0.3s
            aura none duration 0.4s
            right_arm 0 duration 0.4s
