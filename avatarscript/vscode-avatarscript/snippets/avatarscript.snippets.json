{
  "Scene Template (16:9 YouTube)": {
    "prefix": "scene",
    "body": [
      "scene \"${1:anime_reaction}\":",
      "",
      "    canvas ${2:1920x1080}",
      "    background \"${3:#202020}\"",
      "    fps ${4:30}",
      "    duration ${5:12s}",
      "",
      "    avatar \"${6:main}\":",
      "        character \"${7:default}\"",
      "        position ${8|right,center,left|}",
      "        scale ${9:1.2}",
      "",
      "        idle:",
      "            breathe",
      "            blink every ${10:4s}",
      "",
      "        at 0s:",
      "            expression ${11|neutral,happy,surprised,shocked,sad,angry|}",
      "",
      "    render \"${1:anime_reaction}.mp4\""
    ],
    "description": "Create a complete 16:9 AvatarScript scene with an avatar and idle loop"
  },
  "Shorts Vertical Scene Template (9:16 60fps)": {
    "prefix": "shorts",
    "body": [
      "scene \"${1:manhwa_shorts}\":",
      "",
      "    canvas 1080x1920",
      "    background \"${2:#141622}\"",
      "    fps 60",
      "    duration ${3:10s}",
      "",
      "    avatar \"${4:narrator}\":",
      "        character \"${5:default}\"",
      "        position x:540 y:1420",
      "        scale 1.15",
      "",
      "        idle:",
      "            breathe",
      "            blink every 3.5s",
      "",
      "        at 0s:",
      "            expression neutral",
      "",
      "    render \"${1:manhwa_shorts}.mp4\""
    ],
    "description": "Create a 9:16 vertical 60 FPS Shorts reaction avatar scene"
  },
  "Avatar Block": {
    "prefix": "avatar",
    "body": [
      "avatar \"${1:host}\":",
      "    character \"${2:default}\"",
      "    position ${3|right,center,left|}",
      "    scale ${4:1.1}",
      "",
      "    idle:",
      "        breathe",
      "        blink every ${5:4s}",
      "",
      "    at 0s:",
      "        expression ${6|neutral,happy,surprised,shocked,sad,angry|}"
    ],
    "description": "Insert an avatar definition block"
  },
  "Timeline Block (at Ns:)": {
    "prefix": "at",
    "body": [
      "at ${1:3}s:",
      "    expression ${2|surprised,shocked,happy,angry,sad,neutral|}",
      "    ${0}"
    ],
    "description": "Insert a timestamped timeline block"
  },
  "Animate Shake": {
    "prefix": "shake",
    "body": [
      "animate shake duration ${1:0.4s} intensity ${2:15}"
    ],
    "description": "Insert a damped horizontal shake animation"
  },
  "Animate Bounce": {
    "prefix": "bounce",
    "body": [
      "animate bounce duration ${1:0.6s} easing ${2|ease_out,linear,ease_in_out|}"
    ],
    "description": "Insert a vertical jump bounce animation"
  },
  "Move Avatar": {
    "prefix": "move",
    "body": [
      "move x:${1:30} y:${2:0} duration ${3:0.4s} easing ${4|ease_in_out,ease_out,ease_in,linear|}"
    ],
    "description": "Move avatar by relative (x, y) offset"
  }
}
